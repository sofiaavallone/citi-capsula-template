{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "prisma db push && tsx src/index.ts",
    "postinstall": "prisma generate --no-hints",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@repo/types": "workspace:*",
    "@repo/utils": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.0",
    "prisma": "^7.0.0",
    "resend": "^6.32.0",
    "tsx": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.0.0"
  }
}
