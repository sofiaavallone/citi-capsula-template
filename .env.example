# ========== WEB (apps/client/.env.local) ==========
NEXT_PUBLIC_API_URL=http://localhost:3002

# ========== SERVER (apps/server/.env) ==========
# DATABASE_URL: usada pelo server em runtime
# Host = "postgres" (dentro do docker-compose) ou "localhost" (rodando o server local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/capsula?schema=public"

# DATABASE_DIRECT_URL: usada pelo Prisma CLI local (migrations, studio)
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5433/capsula?schema=public"

PORT=3002
WEB_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo

# SMTP para enviar as cartas.
# Dev: Mailpit do docker compose (veja os e-mails em http://localhost:8025).
# Produção (ex.: Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu@gmail.com, SMTP_PASS=<senha de app>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Produção no Railway (SMTP bloqueado nos planos gratuitos): use a API do Resend.
# RESEND_API_KEY=re_...
MAIL_FROM="Cápsula do tempo <cartas@capsula.local>"
